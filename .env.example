# TapLead — environment template. Copy to .env.local and fill in.
# Every variable here is parsed by lib/env.schema.ts at build AND at boot.
# Removing a required one fails the build, not the request (spec Phase 0).

# ---------------------------------------------------------------- public
# Safe to ship to the browser. Nothing secret may go in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The origin written onto the NFC tags. Card URLs are built from this.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------- server
# SERVER ONLY. The service role bypasses every RLS policy in the database.
# Never prefix these NEXT_PUBLIC_. CI gate 2 fails the build if one leaks.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Bearer secrets for /api/jobs/* and /api/cron/* (§15.3). 24+ chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WORKER_SECRET=
CRON_SECRET=

# ------------------------------------------------- optional until phase 4/5
# Redis fails open by design (§24.3) — the app boots and serves without it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Model access (§14.3), through the Vercel AI Gateway. MODEL_API_KEY is an AI
# Gateway key; the model ids choose the provider, so switching is a config change.
# `mock` runs the whole pipeline offline (§25.1) and is what local development
# uses. Production will not run the pipeline on the mock: prospects get the
# template pitch until a real model is set.
#
# The provider is an open decision (§28). Current gateway ids look like:
#   MODEL_PITCH=anthropic/claude-opus-5      # the best model — the pitch is the product
#   MODEL_CHAT=anthropic/claude-sonnet-5     # cheaper; the chatbot is high volume
# List what is available: https://ai-gateway.vercel.sh/v1/models
MODEL_API_KEY=
MODEL_PITCH=mock
MODEL_CHAT=mock
# Company research. Defaults to MODEL_CHAT when unset.
MODEL_RESEARCH=

# Email (§19.2). With no key, alerts are logged and skipped rather than failing.
RESEND_API_KEY=
# The sender, e.g. TapLead <alerts@taplead.app>. Required once RESEND_API_KEY is set.
EMAIL_FROM=
CAL_WEBHOOK_SECRET=

# Queue tuning (§25.3) — the concurrency ceiling, without a code change.
JOB_CONCURRENCY=4
JOB_BATCH=10

# Chatbot kill switch (§18.2).
CHAT_ENABLED=true

SENTRY_DSN=
