# INSIGNAR — environment template. Copy to .env.local and fill in.
# Every variable here is parsed by lib/env.schema.ts at build AND at boot.
# Removing a required one fails the build, not the request (spec Phase 0).

# ---------------------------------------------------------------- public
# Safe to ship to the browser. Nothing secret may go in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The origin written onto the NFC tags. Card URLs are built from this.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------- server
# SERVER ONLY. The service role bypasses every RLS policy in the database.
# Never prefix these NEXT_PUBLIC_. CI gate 2 fails the build if one leaks.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Bearer secrets for /api/jobs/* and /api/cron/* (§15.3). 24+ chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WORKER_SECRET=
CRON_SECRET=

# ------------------------------------------------- optional until phase 4/5
# Redis fails open by design (§24.3) — the app boots and serves without it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Model access (§14.3), through the Vercel AI Gateway. MODEL_API_KEY is an AI
# Gateway key; the model ids choose the provider, so switching is a config change.
# `mock` runs the whole pipeline offline (§25.1) and is what local development
# uses. Production will not run the pipeline on the mock: prospects get the
# template pitch until a real model is set.
#
# The provider is an open decision (§28). Current gateway ids look like:
#   MODEL_PITCH=anthropic/claude-opus-5      # the best model — the pitch is the product
#   MODEL_CHAT=anthropic/claude-sonnet-5     # cheaper; the chatbot is high volume
# List what is available: https://ai-gateway.vercel.sh/v1/models
MODEL_API_KEY=
# Optional: `openrouter` sends model calls through OpenRouter (with zero-data-retention
# routing requested) instead of the Vercel AI Gateway. MODEL_API_KEY is then an
# OpenRouter key. Tested ids: deepseek/deepseek-v4-flash-0731 for pitch, chat and research.
MODEL_PROVIDER=
MODEL_PITCH=mock
MODEL_CHAT=mock
# Company research. Defaults to MODEL_CHAT when unset.
MODEL_RESEARCH=
# Reads a photographed business card ("Scan their card"). Unset = the button is hidden.
# Tested: deepseek/deepseek-v4-flash-vision-exp (2 to 3 s a card).
MODEL_VISION=

# Fast typed decisions (which website is official, which profile matches). Uses
# MODEL_API_KEY, so it needs MODEL_PROVIDER=openrouter. Off when that is not set.
JEV_ENABLED=true
JEV_MODEL=typesafe/jev-1.13

# Web search for "Find their website" and "Search the web for LinkedIn".
# brave | serper | serpapi | mock (mock = canned results for local work only).
# Unset = the two buttons are hidden. Search terms and results are never stored.
SEARCH_PROVIDER=
SEARCH_API_KEY=
# Optional second source, used when the first returns nothing or is down.
SEARCH_FALLBACK_PROVIDER=
SEARCH_FALLBACK_API_KEY=

# Email (§19.2). With no key, alerts are logged and skipped rather than failing.
RESEND_API_KEY=
# The sender, e.g. INSIGNAR <alerts@taplead.app>. Required once RESEND_API_KEY is set.
EMAIL_FROM=
# Booking (§19.1). The secret you set on the Cal.com webhook pointing at
# https://<your domain>/api/webhooks/cal (events: booking created, rescheduled,
# cancelled). Without it the webhook answers 503 and bookings are not linked.
CAL_WEBHOOK_SECRET=

# Operator console (/ops): comma-separated emails of INSIGNAR staff. Leave blank and
# nobody can open it.
STAFF_EMAILS=

# Queue tuning (§25.3) — the concurrency ceiling, without a code change.
JOB_CONCURRENCY=4
JOB_BATCH=10

# Chatbot kill switch (§18.2).
CHAT_ENABLED=true

SENTRY_DSN=
